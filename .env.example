# ==============================================================================
# POLARIS Navigation & Satellite Observation Environment Configuration
# Smart India Hackathon 2026 | MoES / NCPOR (PS ID: 26059)
# ==============================================================================

# General Application & Demo Configuration
DEMO_MODE=true
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 1. Live AIS Marine Vessel Tracking (AISStream.io)
# ------------------------------------------------------------------------------
# Register for a free API key at: https://aisstream.io/
# When left blank, POLARIS automatically falls back to an authentic Southern Ocean
# polar fleet (research vessels, icebreakers, supply ships).
AISSTREAM_API_KEY=

# ------------------------------------------------------------------------------
# 2. ESA Copernicus Data Space Ecosystem (CDSE) / Sentinel-1 SAR
# ------------------------------------------------------------------------------
# Portal & Registration: https://dataspace.copernicus.eu/
# Documentation: https://documentation.dataspace.copernicus.eu/APIs/OData.html
# Used to query Near-Real-Time (NRT) Sentinel-1 Synthetic Aperture Radar (C-SAR)
# Level-1 Ground Range Detected (GRD) Extra-Wide (EW) imagery over Antarctica.
# If credentials are not provided, POLARIS seamlessly utilizes authentic cached
# BYU/USNIC observations in `backend/data/satellite_iceberg_tracks.json`.
COPERNICUS_CDSE_CLIENT_ID=
COPERNICUS_CDSE_CLIENT_SECRET=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_ODATA_API_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# ------------------------------------------------------------------------------
# 3. NASA Earthdata (GIBS & ICESat-2 ATLAS / MODIS NRT)
# ------------------------------------------------------------------------------
# Portal & Registration: https://urs.earthdata.nasa.gov/
# Token Generation: https://urs.earthdata.nasa.gov/users/tokens
# Used for NASA Common Metadata Repository (CMR) queries and ICESat-2 ATL07
# sea ice height/freeboard profiling and GIBS satellite imagery overlays.
NASA_EARTHDATA_TOKEN=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_CMR_SEARCH_URL=https://cmr.earthdata.nasa.gov/search/granules.json
NASA_GIBS_WMTS_URL=https://gibs.earthdata.nasa.gov/wmts/epsg4326/best/wmts.cgi

# ------------------------------------------------------------------------------
# 4. BYU Center for Remote Sensing (MERS) / USNIC Antarctic Iceberg Database
# ------------------------------------------------------------------------------
# Public open data archive (no API key required).
# Reference: https://www.scp.byu.edu/data/iceberg/
# Historical radar scatterometer (QuikSCAT, ASCAT, OSCAT) and NIC weekly tracking.
BYU_ICEBERG_DATA_URL=https://www.scp.byu.edu/data/iceberg/
BYU_CONSOLIDATED_DB_URL=https://www.scp.byu.edu/data/iceberg/updated7_consol/

# ------------------------------------------------------------------------------
# 5. CelesTrak Live Orbital Elements (SGP4 Satellite Propagation)
# ------------------------------------------------------------------------------
# Public open data feed (no API key required).
# Provides two-line element (TLE) sets for Sentinel-1A, CryoSat-2, ICESat-2, etc.
CELESTRAK_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=resource&FORMAT=tle
CELESTRAK_WEATHER_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=weather&FORMAT=tle

# ------------------------------------------------------------------------------
# 6. Google Gemini AI API (Situational Intelligence & Bridge Summaries)
# ------------------------------------------------------------------------------
# Get a free API key at: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=
